# Loaded when mode is `development` — e.g. `npm run dev` or `npm run build:dev`.
# https://vitejs.dev/guide/env-and-mode.html

# Brand (client + index.html via vite.config transform)
VITE_APP_NAME=Potter Wiki development
VITE_APP_LOGO_URL=/potterwiki-logo.png

# Send events to GA4 while developing (use a separate GA4 property if you want to isolate dev traffic).
VITE_ENABLE_ANALYTICS=true

# Verbose `[analytics]` logs + gtag `debug_mode` — set to false for quieter local runs.
VITE_GA_DEBUG=true

# Same property as production by default; change here only if you use a dedicated dev GA4 stream.
VITE_GA_MEASUREMENT_ID=G-JSFW6F07X6
