# Loaded when mode is `production` — e.g. `npm run build`, `npm run preview`, or one-shot `npm run start:prod`.
# Use this for deploys and your future `live` branch — swap IDs here without touching code.

# Brand (client + index.html). Use absolute `https://…` for og:image if social previews must resolve cross-domain.
VITE_APP_NAME=Potter Wiki
VITE_APP_LOGO_URL=/potterwiki-logo.png

# Analytics on for production users.
VITE_ENABLE_ANALYTICS=true

# No debug_mode / noisy console logging in production (set true briefly to validate a deploy).
VITE_GA_DEBUG=false

# Production GA4 property; update when you add a separate "live" stream.
VITE_GA_MEASUREMENT_ID=G-JSFW6F07X6
